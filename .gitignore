# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# Data — never commit datasets, embeddings, or indexes
data/raw/*
data/processed/*
data/embeddings/*
data/index/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep
!data/index/.gitkeep

# Model caches
.cache/
*.ckpt
*.safetensors
torch_hub/
huggingface/

# Experiments keep JSON summaries, not heavy artifacts
experiments/*/checkpoints/

# Reports: figures are regenerated by scripts/generate_figures.py
reports/figures/*.png
reports/figures/*.pdf

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/next-env.d.ts

# Demo bundle is built artifacts, but small enough to ship — keep it
!frontend/public/demo/

# OS / editor
.DS_Store
.idea/
.vscode/
*.log
frontend/tsconfig.tsbuildinfo

# Derived checkpoint-study artifacts
data/scaling/
