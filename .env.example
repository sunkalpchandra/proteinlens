# Backend ---------------------------------------------------------------
# ESM-2 checkpoint (any HF ESM-2 model id; larger checkpoints need more RAM/VRAM)
PROTEINLENS_MODEL=facebook/esm2_t12_35M_UR50D
# Force a device instead of auto-detection (cuda > mps > cpu)
# PROTEINLENS_DEVICE=cpu
# Comma-separated origins allowed by CORS
PROTEINLENS_CORS_ORIGINS=http://localhost:3000

# Frontend --------------------------------------------------------------
# Point the frontend at a live API; leave unset for static demo mode.
# NEXT_PUBLIC_API_URL=http://localhost:8000
